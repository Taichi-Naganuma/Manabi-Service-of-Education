@page "/members"
@page "/teachers"
@attribute [Authorize]
@inject TeacherApiService TeacherApi
@inject StoryApiService StoryApi
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject AnalyticsService Analytics

<PageTitle>@PageTitle() — Mananect</PageTitle>

<div class="mb-4">
    <h2 class="mb-3">@PageHeading()</h2>

    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <input class="form-control" placeholder="経験・テーマで検索 (例: 起業, 失恋)" @bind="skillFilter" @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="sortBy">
                <option value="">並び替え</option>
                <option value="rating">評価順</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100" @onclick="SearchAsync">検索</button>
        </div>
    </div>
</div>

@if (categoryStories.Count > 0)
{
    <div class="mb-5">
        <h5 class="mb-3 fw-bold">@(string.IsNullOrEmpty(CategoryFilter) ? "最近の経験から" : $"{CategoryFilter}の経験")</h5>
        <div class="row g-3">
            @foreach (var story in categoryStories)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(story.Title))
                            {
                                <p class="mb-1 fw-bold text-primary small">【@story.Title】</p>
                            }
                            <p class="mb-2 lh-base">@GetExcerpt(story.Content)</p>
                            <p class="mb-0 text-muted small">— @story.AuthorName</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0">
                            <a href="/users/@story.AuthorUserId" class="btn btn-sm btn-outline-primary">この人と話す</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <hr class="mt-4" />
    </div>
}

@if (isLoading)
{
    <p>読み込み中...</p>
}
else if (filteredMembers.Count == 0)
{
    @if (members.Count == 0)
    {
        <div class="text-center mt-5">
            <p class="display-6 mb-3">🌱</p>
            <h4 class="mb-3">まだ誰もいません</h4>
            <p class="text-muted mb-2">あなたが最初のSpeakerになりませんか？</p>
            <p class="text-muted small mb-4">経験を登録すると、あなたの話を聞きたい人と出会えます。</p>
            <a href="/profile" class="btn btn-primary">経験を登録する</a>
        </div>
    }
    else
    {
        <div class="text-center mt-5 text-muted">
            <p class="fs-5 mb-2">このカテゴリーの経験者がまだいません</p>
            <p class="small mb-4">あなたがこの経験を持っているなら、最初の1人になれます。</p>
            <a href="/profile" class="btn btn-outline-primary">経験を登録する</a>
        </div>
    }
}
else
{
    <div class="row g-4">
        @foreach (var member in filteredMembers)
        {
            <div class="col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(member.Bio))
                        {
                            <blockquote class="mb-3" style="border-left:4px solid #0d6efd;padding-left:12px;margin:0;">
                                <p class="mb-0 fw-normal lh-base">
                                    @{
                                        var bioExcerpt = member.Bio.Length > 150
                                            ? member.Bio[..150] + "…"
                                            : member.Bio;
                                    }
                                    @bioExcerpt
                                </p>
                            </blockquote>
                        }

                        <div class="d-flex align-items-center mb-3 mt-3">
                            @if (member.AvatarUrl is not null)
                            {
                                <img src="@member.AvatarUrl" class="rounded-circle me-2" width="40" height="40" alt="avatar" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary me-2 d-flex align-items-center justify-content-center text-white fw-bold"
                                     style="width:40px;height:40px;font-size:14px">
                                    @member.DisplayName[..1]
                                </div>
                            }
                            <div>
                                <h6 class="mb-0">@member.DisplayName</h6>
                                <div class="mt-1">
                                    <RoleBadge IsSpeaker="true" IsListener="false" />
                                </div>
                            </div>
                        </div>

                        @if (member.LifeDecisions.Count > 0)
                        {
                            <div class="mb-2">
                                @foreach (var ld in member.LifeDecisions.Take(3))
                                {
                                    var label = GetDecisionLabel(ld.DecisionKey);
                                    var years = ld.YearsAgo.HasValue ? $"（{ld.YearsAgo}年前）" : "";
                                    <span class="badge me-1 mb-1" style="background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;">🌿 @label@years</span>
                                }
                            </div>
                        }

                        @if (member.Skills.Count > 0)
                        {
                            <div class="mb-2">
                                @foreach (var skill in member.Skills.Take(3))
                                {
                                    <span class="badge bg-light text-dark me-1 border mb-1">@skill</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-sm btn-primary w-100"
                                @onclick="() => GoToProfile(member.UserId)">
                            この経験を聞く
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryFilter { get; set; }

    [SupplyParameterFromQuery(Name = "lifeDecision")]
    public string? LifeDecisionFilter { get; set; }

    private List<TeacherProfileResponse> members = [];
    private List<StoryDto> categoryStories = [];
    private string? currentUserId;

    private List<TeacherProfileResponse> filteredMembers => members
        .Where(m => m.UserId != currentUserId)
        .Where(m => string.IsNullOrEmpty(CategoryFilter) || m.Categories.Contains(CategoryFilter))
        .ToList();

    private bool isLoading = true;
    private string skillFilter = "";
    private string sortBy = "";

    private string PageTitle() =>
        !string.IsNullOrEmpty(LifeDecisionFilter) ? GetDecisionLabel(LifeDecisionFilter) + "の経験者"
        : !string.IsNullOrEmpty(CategoryFilter) ? CategoryFilter
        : "メンバーを探す";

    private string PageHeading() =>
        !string.IsNullOrEmpty(LifeDecisionFilter) ? $"「{GetDecisionLabel(LifeDecisionFilter)}」の経験者"
        : !string.IsNullOrEmpty(CategoryFilter) ? $"{CategoryFilter}の経験を持つ人"
        : "メンバーを探す";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst("sub")?.Value;
        await Task.WhenAll(SearchAsync(), LoadStoriesAsync());
    }

    private async Task SearchAsync()
    {
        isLoading = true;
        members = await TeacherApi.GetTeachersAsync(
            skill: string.IsNullOrEmpty(skillFilter) ? null : skillFilter,
            lifeDecision: string.IsNullOrEmpty(LifeDecisionFilter) ? null : LifeDecisionFilter,
            sortBy: string.IsNullOrEmpty(sortBy) ? null : sortBy);
        isLoading = false;
        if (!string.IsNullOrEmpty(skillFilter) || !string.IsNullOrEmpty(CategoryFilter) || !string.IsNullOrEmpty(LifeDecisionFilter))
            Analytics.Track("search_executed", "/members", null, skillFilter ?? LifeDecisionFilter);
    }

    private async Task LoadStoriesAsync()
    {
        categoryStories = await StoryApi.GetStoriesAsync(
            category: string.IsNullOrEmpty(CategoryFilter) ? null : CategoryFilter,
            limit: 4);
    }

    private void GoToProfile(string userId) => Nav.NavigateTo("/users/" + userId);

    private static string GetExcerpt(string content, int max = 100)
        => content.Length > max ? content[..max] + "…" : content;

    private static string GetDecisionLabel(string key) => key switch
    {
        "career_change" => "転職した",
        "entrepreneurship" => "起業を経験した",
        "leave_of_absence" => "休職した",
        "went_independent" => "独立した",
        "got_married" => "結婚した",
        "divorced" => "離婚した",
        "relationship_other" => "関係性の岐路",
        "became_parent" => "子どもを持った",
        "chose_no_children" => "子どもを持たない選択",
        "caregiving" => "親を介護した・見送った",
        "illness" => "病気と向き合った",
        "broke_habit" => "依存・習慣を断ち切った",
        "left_university" => "大学を辞めた",
        "went_back_to_school" => "学位を取り直した",
        "lost_someone" => "大切な人を失った",
        "changed_direction" => "夢を諦めた・方向転換した",
        "found_dream" => "夢を見つけた",
        "lived_abroad" => "海外移住・留学した",
        "mental_rock_bottom" => "精神的などん底にいた・今もそこにいる",
        _ => key
    };
}
